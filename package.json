{
  "name": "private-bookmarks",
  "version": "1.0.0",
  "private": true,
  "description": "一个运行在个人 NAS 上的私有跨浏览器书签同步系统",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "dev:server": "pnpm --filter @private-bookmarks/server dev",
    "dev:web": "pnpm --filter @private-bookmarks/web dev",
    "build:extension": "pnpm --filter @private-bookmarks/extension build",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  }
}
