# Private Bookmarks 服务器配置
# 复制为 .env 并修改后使用：docker compose up -d

# Docker 镜像（docker compose 使用；默认 Docker Hub 官方镜像，也可改为自建镜像名）
IMAGE=jerry0510/private-bookmarks:latest

# 宿主机端口（容器内固定 8080，此变量仅控制映射）
# PORT=8080

NODE_ENV=production
PORT=8080

# 对外访问地址（用于 Cookie Secure 标记与来源校验，本地 http 测试可留空或写 http://NAS-IP:8080）
BASE_URL=https://bookmark.example.com

# 管理员账号（首次启动时自动创建）
ADMIN_USERNAME=admin
# 必须修改！留空则首次启动随机生成并打印在日志中
ADMIN_PASSWORD=

# Session 签名密钥（必填，请使用长随机字符串：openssl rand -base64 48）
SESSION_SECRET=

# SQLite 数据库文件路径（容器内路径，对应 compose 卷挂载 ./data:/app/data）
DATABASE_URL=/app/data/bookmarks.db

# Session 有效期（天）
SESSION_TTL_DAYS=30

# 登录接口限流（每 IP 每 5 分钟最大尝试次数）
LOGIN_RATE_LIMIT_MAX=5

# 同步接口限流（每 Token 每分钟最大请求数）
SYNC_RATE_LIMIT_PER_MINUTE=120

# 额外允许的 CORS / CSRF 来源（逗号分隔，例如 chrome-extension://xxxxxxxx）
ALLOWED_ORIGINS=

# 是否信任反向代理的 X-Forwarded-For（决定限流的客户端 IP 判定）
TRUST_PROXY=false

# 自动备份
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7

# Web 静态资源目录（一般无需修改，Docker 镜像内已配置好）
# WEB_DIST=/app/web-dist
