{
  "name": "@private-bookmarks/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^8.1.0",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.2",
    "fastify": "^5.3.3"
  },
  "devDependencies": {
    "@private-bookmarks/shared": "workspace:*",
    "@private-bookmarks/sync-protocol": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
