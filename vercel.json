{
  "version": 2,
  "buildCommand": "pnpm --filter @private-bookmarks/website build",
  "devCommand": "pnpm --filter @private-bookmarks/website dev",
  "installCommand": "pnpm install",
  "framework": "vite",
  "outputDirectory": "apps/website/dist",
  "rewrites": [
    { "source": "/zh", "destination": "/zh/index.html" },
    { "source": "/zh/:path*", "destination": "/zh/index.html" },
    { "source": "((?!/assets/|/favicon.ico|/robots.txt|/sitemap.xml|/api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
